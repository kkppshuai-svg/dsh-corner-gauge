{
  "name": "dsh-corner-gauge",
  "version": "2.1.0",
  "description": "A skinnable corner balance badge for DeepSeek Harness — swap the frame template, compose the panel from elements",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "node scripts/lint.mjs",
    "smoke": "node scripts/smoke-engine.mjs",
    "test": "npm run lint && npm run verify && npm run smoke",
    "import": "node scripts/import-car.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkppshuai-svg/dsh-corner-gauge.git"
  },
  "homepage": "https://github.com/kkppshuai-svg/dsh-corner-gauge#readme",
  "bugs": {
    "url": "https://github.com/kkppshuai-svg/dsh-corner-gauge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "badge",
    "hud",
    "theme",
    "skin"
  ],
  "license": "MIT"
}
