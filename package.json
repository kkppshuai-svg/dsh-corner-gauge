{
  "name": "dsh-corner-gauge",
  "version": "2.1.0",
  "description": "A skinnable corner balance badge for DeepSeek Harness — swap the frame template, compose the panel from elements",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compat": {
      "dsh": ">=0.2.1-rc.2 <0.3",
      "node": ">=18",
      "clientPlatform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "node scripts/lint.mjs",
    "smoke": "node scripts/smoke-engine.mjs",
    "test": "npm run lint && npm run verify && npm run digits && npm run smoke && npm run smoke:mount",
    "import": "node scripts/import-car.mjs",
    "digits": "node scripts/check-digits.mjs",
    "bridge": "node bridge/server.mjs",
    "bridge:once": "node bridge/server.mjs --once",
    "smoke:mount": "node scripts/smoke-mount.mjs",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkppshuai-svg/dsh-corner-gauge.git"
  },
  "homepage": "https://github.com/kkppshuai-svg/dsh-corner-gauge#readme",
  "bugs": {
    "url": "https://github.com/kkppshuai-svg/dsh-corner-gauge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "badge",
    "hud",
    "theme",
    "skin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  }
}
